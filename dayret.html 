            margin-bottom: 0;
            padding-bottom: 0;
        }
        
        .session-time {
            min-width: 120px;
            font-weight: 600;
            color: var(--forest);
        }
        
        /* Teacher */
        .teacher-card {
            background: white;
            padding: 2rem;
            border: 1px solid var(--stone);
            border-radius: 4px;
            margin: 1rem 0;
