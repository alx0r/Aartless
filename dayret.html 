            const eventStart = new Date('2026-01-16');
            const earlyBirdEnd = new Date('2025-11-30');
            
            const phaseIndicator = document.querySelector('.phase-indicator');
            
            if (today < earlyBirdEnd) {
                phaseIndicator.textContent = 'CURRENT PHASE: Early Registration';
                phaseIndicator.style.background = '#E74C3C';
            } else if (today < eventStart) {
                phaseIndicator.textContent = 'CURRENT PHASE: Regular Registration';
                phaseIndicator.style.background = '#F39C12';
            } else if (today >= eventStart && today <= new Date('2026-01-21')) {
                phaseIndicator.textContent = 'CURRENT PHASE: Live Event';
                phaseIndicator.style.background = '#2ECC71';
            } else {
                phaseIndicator.textContent = 'CURRENT PHASE: Completed';
                phaseIndicator.style.background = '#7F8C8D';
            }
            
            // Add booking button functionality
            const bookButtons = document.querySelectorAll('.cta-button');
            bookButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    // In a real implementation, this would open a booking modal
                    alert('Booking system would open here. This could connect to a simple form or payment processor.');
                });
            });
            
            // Add smooth scrolling for navigation
            const navLinks = document.querySelectorAll('.nav-links a');
            navLinks.forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    const targetId = this.getAttribute('href');
                    const targetElement = document.querySelector(targetId);
                    
                    if (targetElement) {
                        window.scrollTo({
                            top: targetElement.offsetTop - 80,
                            behavior: 'smooth'
                        });
                    }
                });
            });
            
            // Add some interactive elements to schedule items
            const scheduleItems = document.querySelectorAll('.schedule-item');
            scheduleItems.forEach(item => {
                item.addEventListener('mouseenter', function() {
                    this.style.background = 'rgba(243, 156, 18, 0.1)';
                    this.style.transition = 'background 0.3s ease';
                });
                
                item.addEventListener('mouseleave', function() {
                    this.style.background = 'transparent';
                });
            });
        });
