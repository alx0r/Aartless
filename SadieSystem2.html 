        }
        
        .playlist .song-title {
            color: var(--metallic-gold);
            font-weight: 600;
        }
        
        .playlist .artist {
            color: var(--silver);
        }
        
        footer {
            background: var(--deep-purple);
            color: var(--light-text);
            text-align: center;
            padding: 3rem 2rem;
            margin-top: 5rem;
            border-top: 3px solid var(--metallic-gold);
        }
        
        footer p {
            margin: 0.5rem 0;
            font-size: 0.95rem;
        }
        
        .status-badge {
            display: inline-block;
            padding: 0.5rem 1.5rem;
            background: var(--deep-red);
            color: white;
            border-radius: 25px;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin: 1rem 0;
            font-weight: 600;
        }
        
        @media (max-width: 768px) {
            .bride-name {
                font-size: 2rem;
            }
            
            .section-title {
                font-size: 2rem;
            }
            
            nav ul {
                flex-direction: column;
                gap: 1rem;
                align-items: center;
            }
            
            .timeline::before {
                left: 20px;
            }
            
            .timeline-item {
                padding-left: 60px;
            }
            
            .timeline-marker {
                left: 10px;
            }
        }
    </style>
</head>
<body>
