            padding-bottom: 0.5rem;
            border-bottom: 1px solid var(--stone);
        }
        
        .session {
            display: flex;
            margin-bottom: 1rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--stone);
        }
        
        .session:last-child {
