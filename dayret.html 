<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vinyasa Krama Immersion | Valley Shala</title>
    
    <!-- Critical CSS Inlined -->
    <style>
        /* CRITICAL CSS - Loads immediately */
        :root {
            --color-deep: #2C3E50;
            --color-accent: #E74C3C;
            --color-gold: #F39C12;
            --color-light: #ECF0F1;
            --color-mid: #7F8C8D;
            --color-dark: #1A252F;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            line-height: 1.6;
            color: var(--color-light);
            background: var(--color-dark);
            min-height: 100vh;
        }
        
        /* Progressive Loading States */
        .skeleton {
            background: linear-gradient(90deg, #2C3E50 25%, #34495E 50%, #2C3E50 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
            border-radius: 4px;
        }
        
        @keyframes loading {
            0% { background-position: 200% 0; }
            100% { background-position: -200% 0; }
        }
        
        /* Critical Layout */
        .app-shell {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        .hero-critical {
            min-height: 60vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 2rem;
            background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-deep) 100%);
        }
        
        .hero-skeleton {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
        }
        
        .skeleton-badge {
            width: 120px;
            height: 30px;
            margin: 0 auto 2rem;
        }
        
        .skeleton-title {
            width: 80%;
            height: 60px;
            margin: 0 auto 1rem;
        }
        
        .skeleton-subtitle {
            width: 60%;
            height: 30px;
            margin: 0 auto 2rem;
        }
        
        .skeleton-button {
            width: 200px;
            height: 50px;
            margin: 0 auto;
        }
    </style>
    
    <!-- Preload critical resources -->
    <link rel="preload" as="style" href="#full-styles">
    <link rel="prefetch" href="#interactive-content">
</head>
<body>
    <div class="app-shell">
        <!-- Critical Above-the-Fold Content -->
        <section class="hero-critical" id="critical-hero">
            <div class="hero-skeleton">
                <div class="skeleton-badge skeleton"></div>
                <div class="skeleton-title skeleton"></div>
                <div class="skeleton-subtitle skeleton"></div>
                <div class="skeleton-button skeleton"></div>
            </div>
        </section>
    </div>

    <!-- Full Content - Loaded After Critical Render -->
    <script>
        // Enhanced loading strategy with performance monitoring
        (function() {
            'use strict';
            
            // Performance markers
            performance.mark('loading-start');
            
            // Load full content after critical render
            function loadFullContent() {
                // Remove skeleton
                const criticalHero = document.getElementById('critical-hero');
                if (criticalHero) {
                    criticalHero.style.opacity = '0';
                    setTimeout(() => {
                        criticalHero.innerHTML = '';
                        criticalHero.style.opacity = '1';
                        injectFullContent();
                    }, 50);
                } else {
                    injectFullContent();
                }
            }
            
            // Inject full content
