                            <a href="#updates" data-navigate>Updates</a>
                            <a href="#details" data-navigate>Details</a>
                            <a href="#schedule" data-navigate>Schedule</a>
                            <a href="#teacher" data-navigate>Teacher</a>
                            <a href="#booking" data-navigate>Book Now</a>
