<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sadie Bosworth Atelier - Content Strategy Enhancement</title>
    <meta name="description" content="Comprehensive content strategy for luxury bridal atelier focusing on SEO, user experience, and conversion optimization">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Georgia', serif;
            line-height: 1.6;
            color: #2c2c2c;
            background: linear-gradient(135deg, #f5f1eb 0%, #faf8f3 100%);
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .hero {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600"><rect fill="%23d4af8c" width="1200" height="600"/><path fill="%23f5f1eb" opacity="0.3" d="M0,300 Q300,150 600,300 T1200,300 V600 H0 Z"/></svg>');
            background-size: cover;
            background-position: center;
            color: white;
            text-align: center;
            padding: 80px 0;
            position: relative;
        }

        .hero h1 {
            font-size: 3.5rem;
            margin-bottom: 20px;
            font-weight: 300;
            letter-spacing: 2px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        .hero p {
            font-size: 1.3rem;
            margin-bottom: 30px;
            font-style: italic;
            opacity: 0.95;
        }

        .section {
            padding: 60px 0;
            margin-bottom: 40px;
        }

        .section h2 {
            font-size: 2.5rem;
            margin-bottom: 30px;
            color: #8b4513;
            text-align: center;
            position: relative;
        }

        .section h2::after {
            content: '';
            display: block;
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, #d4af8c, #8b4513);
            margin: 15px auto;
            border-radius: 2px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 40px;
            margin-top: 40px;
        }

        .card {
            background: white;
            padding: 40px 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            border-left: 5px solid #d4af8c;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        }

        .card h3 {
            color: #8b4513;
            margin-bottom: 20px;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .icon {
            width: 24px;
            height: 24px;
            background: #d4af8c;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 14px;
            font-weight: bold;
        }

        .card ul {
            list-style: none;
            padding-left: 0;
        }

        .card li {
            margin-bottom: 12px;
            padding-left: 25px;
            position: relative;
        }

        .card li::before {
            content: '✦';
            position: absolute;
            left: 0;
            color: #d4af8c;
            font-weight: bold;
        }

        .timeline {
            background: white;
            padding: 50px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            margin: 40px 0;
        }

        .timeline-item {
            display: flex;
            margin-bottom: 30px;
            align-items: flex-start;
            gap: 20px;
        }

        .timeline-number {
            background: linear-gradient(135deg, #d4af8c, #8b4513);
            color: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            flex-shrink: 0;
        }

        .timeline-content h4 {
            color: #8b4513;
            margin-bottom: 10px;
            font-size: 1.2rem;
        }

        .cta-section {
            background: linear-gradient(135deg, #8b4513, #d4af8c);
            color: white;
            text-align: center;
            padding: 60px 40px;
            border-radius: 20px;
            margin: 60px 0;
        }

        .cta-section h2 {
            color: white;
            margin-bottom: 20px;
        }

        .cta-section h2::after {
            background: rgba(255,255,255,0.3);
        }

        .btn {
            display: inline-block;
            background: white;
            color: #8b4513;
            padding: 15px 30px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: bold;
            margin: 10px;
            transition: all 0.3s ease;
            border: 2px solid white;
        }

        .btn:hover {
            background: transparent;
            color: white;
            transform: translateY(-2px);
        }

        .metrics {
            background: #f8f6f0;
            padding: 40px;
            border-radius: 15px;
            margin: 40px 0;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 30px;
            text-align: center;
        }

        .metric {
            background: white;
            padding: 30px 20px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .metric-number {
            font-size: 2.5rem;
            font-weight: bold;
            color: #8b4513;
            display: block;
        }

        .metric-label {
            color: #666;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        footer {
            background: #2c2c2c;
            color: white;
            text-align: center;
            padding: 40px 0;
            margin-top: 80px;
        }

        footer a {
            color: #d4af8c;
            text-decoration: none;
        }

        footer a:hover {
            color: #f5f1eb;
        }

        @media (max-width: 768px) {
            .hero h1 {
                font-size: 2.5rem;
            }
            
            .hero p {
                font-size: 1.1rem;
            }
            
            .section h2 {
                font-size: 2rem;
            }
            
            .grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }
            
            .card {
                padding: 30px 20px;
            }
            
            .timeline {
                padding: 30px 20px;
            }
        }

        .highlight {
            background: linear-gradient(120deg, rgba(212, 175, 140, 0.2) 0%, rgba(212, 175, 140, 0.2) 100%);
            padding: 2px 8px;
            border-radius: 4px;
            font-weight: 600;
        }

        .status-indicator {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 8px;
        }

        .status-good { background: #4CAF50; }
        .status-warning { background: #FF9800; }
        .status-critical { background: #F44336; }
    </style>
</head>

