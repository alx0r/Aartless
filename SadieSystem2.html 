        }
        
        .tag.fitting {
            background: var(--fairy-green);
            color: white;
        }
        
        .divider {
            text-align: center;
            font-size: 2rem;
            color: var(--metallic-gold);
            margin: 3rem 0;
        }
        
        .measurements-table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .measurements-table th,
        .measurements-table td {
            padding: 1rem;
            text-align: left;
            border-bottom: 1px solid rgba(212, 175, 55, 0.3);
