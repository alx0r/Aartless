    main {
      flex: 1;
      display: flex;
      justify-content: center;
      padding: 20px;
    }

    .container {
      background: #111;
      padding: 25px;
      border-radius: 12px;
      max-width: 900px;
      width: 100%;
      box-shadow: 0 0 15px rgba(0, 255, 0, 0.2);
    }

    .container h2 {
      border-bottom: 2px solid #00FF00;
      padding-bottom: 10px;
      margin-bottom: 20px;
    }

    ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    li {
      background: #111;
      border: 1px solid #00FF00;
      padding: 15px;
      margin-bottom: 12px;
      border-radius: 6px;
      transition: background 0.3s, transform 0.2s;
      cursor: pointer;
    }

    li:hover {
      background: #222;
      transform: translateY(-2px);
    }

    li p {
      display: none;
      margin-top: 10px;
      font-size: 0.9rem;
      color: #0f0;
    }

    li.open p {
      display: block;
    }

    a {
      color: #00FF00;
      text-decoration: none;
      font-weight: bold;
    }

    a:hover {
      text-decoration: underline;
    }

    .classified {
      color: #888;
      border-color: #550000;
      font-style: italic;
    }

    footer {
      text-align: center;
      padding: 15px;
      font-size: 0.85em;
      color: #00FF00;
      border-top: 1px solid #0f0;
    }

    @media (max-width: 600px) {
      .container {
        padding: 15px;
      }
      li {
        padding: 12px;
      }
    }
