                            grid-template-columns: 1fr;
                        }
                    }
                    
                    /* Reduced motion support */
                    @media (prefers-reduced-motion: reduce) {
                        * {
                            animation-duration: 0.01ms !important;
                            animation-iteration-count: 1 !important;
                            transition-duration: 0.01ms !important;
                        }
                    }
                `;
                document.head.appendChild(style);
            }
            
            // Initialize interactive features
            function initializeApp() {
                // Smooth scrolling for navigation
                document.querySelectorAll('[data-navigate]').forEach(link => {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        const target = document.querySelector(this.getAttribute('href'));
                        if (target) {
                            target.scrollIntoView({ behavior: 'smooth' });
                        }
                    });
                });
                
                // Expandable content
                document.querySelectorAll('[data-expand]').forEach(button => {
                    button.addEventListener('click', function() {
                        const targetClass = this.getAttribute('data-expand');
                        const target = this.closest('.teacher-card-mini');
                        if (target) {
                            target.classList.toggle('expanded');
                            this.textContent = target.classList.contains('expanded') ? 'Show less' : 'Read full bio';
                        }
                    });
                });
                
                // Booking action
                document.querySelectorAll('[data-action="book"]').forEach(button => {
                    button.addEventListener('click', function() {
                        // Simulate booking flow
                        const currentSpots = 6;
                        if (currentSpots > 0) {
                            this.textContent = 'Processing...';
                            this.disabled = true;
                            
                            setTimeout(() => {
                                alert('Booking system would open here. In a real implementation, this would connect to your payment processor.');
                                this.textContent = 'Book Now';
                                this.disabled = false;
                            }, 1000);
                        }
                    });
                });
                
                // Dynamic phase indicator
                function updatePhaseIndicator() {
                    const today = new Date();
                    const earlyBirdEnd = new Date('2025-11-30');
                    const eventStart = new Date('2026-01-16');
                    
                    const indicator = document.querySelector('.phase-indicator');
                    if (!indicator) return;
                    
                    if (today < earlyBirdEnd) {
                        indicator.textContent = 'CURRENT PHASE: Early Registration';
                        indicator.style.background = '#E74C3C';
                    } else if (today < eventStart) {
                        indicator.textContent = 'CURRENT PHASE: Regular Registration';
                        indicator.style.background = '#F39C12';
                    } else {
                        indicator.textContent = 'CURRENT PHASE: Event Completed';
                        indicator.style.background = '#7F8C8D';
                    }
                }
                
                updatePhaseIndicator();
                
                // Lazy load additional content if needed
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            // Could load more content here
                            console.log('Section in view:', entry.target.id);
                        }
                    });
                });
                
                document.querySelectorAll('section').forEach(section => {
                    observer.observe(section);
                });
            }
            
            // Load full content after critical render
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', loadFullContent);
            } else {
                loadFullContent();
            }
        })();
    </script>
</body>
</html>