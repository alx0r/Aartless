                        <div class="details-grid-minimal">
                            <div class="detail-card-mini">
                                <div class="detail-emoji">🧘</div>
                                <h3>Vinyasa Krama</h3>
                                <p>Intelligent sequencing methodology</p>
                            </div>
                            <div class="detail-card-mini">
                                <div class="detail-emoji">📚</div>
                                <h3>Progressive Learning</h3>
                                <p>Systematic daily progression</p>
                            </div>
                            <div class="detail-card-mini">
                                <div class="detail-emoji">👥</div>
                                <h3>Limited to 20</h3>
                                <p>Personalized attention guaranteed</p>
                            </div>
                        </div>
                    </section>

                    <!-- Essential Schedule -->
                    <section class="schedule-essential" id="schedule">
                        <h2>Daily Rhythm</h2>
                        <div class="schedule-minimal">
                            <div class="day-summary">
                                <strong>Mornings:</strong> 7:00-9:30 Practice Intensive
                            </div>
                            <div class="day-summary">
                                <strong>Afternoons:</strong> 16:00-18:30 Theory & Integration
                            </div>
                            <div class="schedule-note">
                                Full detailed schedule available upon registration
                            </div>
                        </div>
                    </section>

                    <!-- Teacher Preview -->
                    <section class="teacher-preview" id="teacher">
                        <h2>About Matthew Sweeney</h2>
                        <div class="teacher-card-mini">
                            <p>Internationally recognized teacher with 25+ years experience. Known for intelligent, creative approach to Vinyasa Yoga.</p>
                            <button class="read-more" data-expand="teacher-bio">Read full bio</button>
                        </div>
                    </section>

                    <!-- Booking CTA -->
                    <section class="booking-optimized" id="booking">
                        <h2>Reserve Your Spot</h2>
                        <div class="price-display">
                            <span class="price">R 4,800</span>
                            <span class="price-note">Early bird until Nov 30</span>
                        </div>
                        <div class="availability">6 spots remaining</div>
                        <button class="cta-button-book" data-action="book">Book Now</button>
                    </section>

                    <!-- Footer -->
                    <footer class="optimized-footer">
                        <p>Valley Shala | Living Retreat Portal</p>
                        <p>Powered by Untitled Format™</p>
                    </footer>
                `;
                
                // Now inject the optimized CSS
                injectOptimizedCSS();
                
                // Initialize interactive features
                initializeApp();
                
                performance.mark('loading-end');
                performance.measure('full-content-load', 'loading-start', 'loading-end');
                
                // Log performance
                const measure = performance.getEntriesByName('full-content-load')[0];
                console.log(`Full content loaded in ${measure.duration.toFixed(2)}ms`);
            }
            
