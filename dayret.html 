                        </div>
                    </section>

                    <!-- Living Updates -->
                    <section class="updates-optimized" id="updates">
                        <h2>Living Updates</h2>
                        <div class="phase-indicator">CURRENT PHASE: Early Registration</div>
                        
                        <div class="updates-container">
                            <article class="update-item">
                                <header class="update-header">
                                    <time datetime="2025-10-30">October 30, 2025</time>
                                    <span class="update-tag">New</span>
                                </header>
                                <div class="update-content">
                                    <p>Early bird registration is now open! Secure your spot before November 30 to receive a 15% discount.</p>
                                </div>
                            </article>
                            
                            <article class="update-item">
                                <header class="update-header">
                                    <time datetime="2025-09-15">September 15, 2025</time>
                                    <span class="update-tag">Schedule</span>
                                </header>
