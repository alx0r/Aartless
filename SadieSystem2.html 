            margin-top: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }
        
        .timeline-status.complete {
            background: var(--fairy-green);
            color: white;
        }
        
        .timeline-status.upcoming {
            background: var(--metallic-gold);
            color: var(--charcoal);
        }
        
        .inspiration-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
        }
        
        .inspiration-item {
            aspect-ratio: 3/4;
            background: linear-gradient(135deg, var(--deep-purple), var(--deep-red));
            border: 1px solid var(--metallic-gold);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            color: white;
            opacity: 0.8;
            position: relative;
            border-radius: 5px;
        }
        
        .inspiration-label {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(0,0,0,0.8);
            color: white;
            padding: 0.75rem;
            font-size: 0.9rem;
            text-align: center;
        }
        
        .notes-log {
            background: rgba(44, 44, 44, 0.8);
            border: 1px solid var(--metallic-gold);
            padding: 0;
            border-radius: 5px;
        }
        
        .note-item {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(212, 175, 55, 0.3);
        }
        
        .note-item:last-child {
            border-bottom: none;
        }
        
        .note-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
        }
        
        .note-author {
            font-weight: 600;
            color: var(--metallic-gold);
            font-size: 1.1rem;
        }
        
        .note-date {
            font-size: 0.85rem;
            color: var(--silver);
