        }
        
        .timeline-marker.upcoming {
            background: var(--silver);
        }
        
        .timeline-date {
            font-size: 0.9rem;
            color: var(--metallic-gold);
            font-weight: 600;
            margin-bottom: 0.25rem;
        }
        
        .timeline-title {
