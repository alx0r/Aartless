      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    header {
      text-align: center;
      padding: 40px 20px 20px;
    }

    header img {
      max-width: 140px;
      border-radius: 50%;
      box-shadow: 0 0 15px rgba(0, 255, 0, 0.8);
      margin-bottom: 15px;
    }

    header h1 {
      margin: 0;
