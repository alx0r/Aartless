        let currentLang = 'en';
        let currentFilter = 'all';

        function switchLang(lang) {
            currentLang = lang;
            
            // Update active button
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.classList.add('active');
            
            // Update all translatable elements
            document.querySelectorAll('[data-en]').forEach(el => {
                const key = `data-${lang}`;
                if (el.hasAttribute(key)) {
                    el.textContent = el.getAttribute(key);
                }
            });
            
            // Regenerate menu
            renderMenu();
        }

        function filterMenu(type) {
            currentFilter = type;
            
            // Update active button
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.target.closest('.filter-btn').classList.add('active');
            
            renderMenu();
        }

        function renderMenu() {
            const container = document.getElementById('menu');
            container.innerHTML = '';
            
            Object.keys(menuData).forEach(sectionKey => {
                const section = menuData[sectionKey];
                const sectionEl = document.createElement('section');
                sectionEl.className = 'section';
                
                const titleEl = document.createElement('h2');
                titleEl.className = 'section-title';
                titleEl.textContent = section.title[currentLang];
                sectionEl.appendChild(titleEl);
                
                section.items.forEach(item => {
                    // Apply filters
                    if (currentFilter === 'vegetarian' && !item.dietary.includes('vegetarian')) return;
                    if (currentFilter === 'spicy' && item.spicy === 0) return;
                    if (currentFilter === 'available' && !item.available) return;
                    
                    const itemEl = document.createElement('div');
                    itemEl.className = 'menu-item';
                    if (!item.available) itemEl.classList.add('unavailable');
                    
                    const itemName = item.nameTranslations && item.nameTranslations[currentLang] 
                        ? item.nameTranslations[currentLang] 
                        : item.name;
                    
                    const description = item.description[currentLang];
                    
                    // Build spicy indicator
                    let spicyIndicator = '';
                    if (item.spicy > 0) {
                        spicyIndicator = '🌶️'.repeat(item.spicy);
                    }
                    
                    // Build dietary indicators
                    let dietaryIndicator = '';
                    if (item.dietary.includes('vegetarian')) {
                        dietaryIndicator = '🥬';
                    }
                    
                    // Price display
                    let priceDisplay = `€${item.price}`;
                    if (item.priceOptions) {
                        priceDisplay = `€${item.prices['250g']} / €${item.prices['500g']}`;
                    }
                    
                    itemEl.innerHTML = `
                        <div class="item-header">
                            <div class="item-name">
                                ${itemName}
                                ${spicyIndicator}
                                ${dietaryIndicator}
                            </div>
                            <div class="item-price">${priceDisplay}</div>
                        </div>
                        <div class="item-description">${description}</div>
                        <div class="badges">
                            ${item.spicy > 0 ? `<span class="badge spicy">${{en:'Spicy', nl:'Pittig', fr:'Épicé'}[currentLang]}</span>` : ''}
                            ${item.dietary.includes('vegetarian') ? `<span class="badge veg">${{en:'Vegetarian', nl:'Vegetarisch', fr:'Végétarien'}[currentLang]}</span>` : ''}
                            ${item.stock === 'low' ? `<span class="badge low-stock">${{en:'Almost Gone!', nl:'Bijna Op!', fr:'Presque Épuisé!'}[currentLang]}</span>` : ''}
                            ${!item.available ? `<span class="badge sold-out">${{en:'Sold Out', nl:'Uitverkocht', fr:'Épuisé'}[currentLang]}</span>` : ''}
                            ${item.allergens.includes('gluten') ? `<span class="badge gluten-free" style="background: #fee2e2; color: #dc2626;">Contains Gluten</span>` : ''}
                        </div>
                        ${item.allergens.length > 0 ? `
                            <div class="allergen-info">
                                ⚠️ ${getAllergenText(item.allergens)}
                            </div>
                        ` : ''}
                    `;
                    
                    sectionEl.appendChild(itemEl);
                });
                
                container.appendChild(sectionEl);
            });
        }

        function getAllergenText(allergens) {
            const allergenTranslations = {
                en: {
                    peanuts: 'Peanuts',
                    gluten: 'Gluten',
                    soy: 'Soy',
                    shellfish: 'Shellfish',
                    fish: 'Fish',
                    eggs: 'Eggs',
                    dairy: 'Dairy'
                },
                nl: {
                    peanuts: 'Pinda\'s',
                    gluten: 'Gluten',
                    soy: 'Soja',
                    shellfish: 'Schaaldieren',
                    fish: 'Vis',
                    eggs: 'Eieren',
                    dairy: 'Zuivel'
                },
                fr: {
                    peanuts: 'Arachides',
                    gluten: 'Gluten',
                    soy: 'Soja',
                    shellfish: 'Crustacés',
                    fish: 'Poisson',
                    eggs: 'Œufs',
                    dairy: 'Produits Laitiers'
                }
            };

            const prefix = {
                en: 'Contains:',
                nl: 'Bevat:',
                fr: 'Contient:'
            };

            const translated = allergens.map(a => allergenTranslations[currentLang][a]).join(', ');
            return `${prefix[currentLang]} ${translated}`;
        }

        // Initial render
        renderMenu();
    </script>
</body>
</html>