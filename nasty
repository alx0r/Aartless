<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nasty Brand Strategy Pitch - Cape Town</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333;
            background: #000;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        .hero {
            background: linear-gradient(135deg, #32CD32 0%, #00FF00 50%, #7FFF00 100%);
            color: #000;
            padding: 80px 0;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(45deg, transparent 30%, rgba(0,0,0,0.1) 50%, transparent 70%);
            animation: shine 3s ease-in-out infinite;
        }

        @keyframes shine {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero h1 {
            font-size: 5rem;
            font-weight: 900;
            margin-bottom: 20px;
            text-shadow: 3px 3px 0px #000;
            letter-spacing: 3px;
            transform: perspective(500px) rotateX(15deg);
        }

        .hero-subtitle {
            font-size: 1.8rem;
            margin-bottom: 30px;
            font-weight: 700;
            text-shadow: 2px 2px 0px #000;
        }

        .section {
            padding: 60px 0;
            background: #fff;
            margin-bottom: 2px;
        }

        .section:nth-child(even) {
            background: #f8f9fa;
        }

        .dark-section {
            background: #1a1a1a;
            color: #fff;
        }

        .dark-section h2 {
            color: #32CD32;
        }

        .section h2 {
            font-size: 2.8rem;
            margin-bottom: 30px;
            color: #000;
            text-align: center;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .brand-showcase {
            background: #000;
            padding: 80px 0;
            text-align: center;
            color: #fff;
        }

        .brand-showcase h2 {
            color: #32CD32;
            font-size: 3rem;
            margin-bottom: 40px;
        }

        .brand-visual {
            max-width: 600px;
            margin: 0 auto 40px;
            background: linear-gradient(135deg, #32CD32 0%, #00FF00 100%);
            padding: 40px;
            border-radius: 20px;
            transform: perspective(1000px) rotateY(-10deg);
        }

        .brand-visual h3 {
            font-size: 4rem;
            color: #000;
            font-weight: 900;
            text-shadow: 2px 2px 0px #fff;
            margin-bottom: 20px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .card {
            background: #fff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            border-left: 8px solid #32CD32;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, transparent 0%, rgba(50,205,50,0.05) 100%);
            z-index: 1;
        }

        .card-content {
            position: relative;
            z-index: 2;
        }

        .card:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 0 25px 50px rgba(50,205,50,0.3);
        }

        .card h3 {
            color: #000;
            font-size: 1.8rem;
            margin-bottom: 15px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .card p {
            color: #333;
            line-height: 1.8;
            font-size: 1.1rem;
        }

        .sticker-strategy {
            background: #32CD32;
            color: #000;
            padding: 80px 0;
            text-align: center;
        }

        .sticker-strategy h2 {
            font-size: 3.5rem;
            margin-bottom: 40px;
            font-weight: 900;
            text-shadow: 2px 2px 0px #fff;
        }

        .sticker-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .sticker-item {
            background: #000;
            color: #32CD32;
            padding: 30px;
            border-radius: 15px;
            font-weight: 700;
            font-size: 1.2rem;
            text-align: center;
            transition: all 0.3s ease;
        }

        .sticker-item:hover {
            transform: scale(1.05);
            background: #32CD32;
            color: #000;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
            background: #000;
            color: #fff;
            padding: 60px 0;
            text-align: center;
        }

        .stat {
            padding: 20px;
        }

        .stat-number {
            font-size: 4rem;
            font-weight: 900;
            color: #32CD32;
            display: block;
            text-shadow: 2px 2px 0px #000;
        }

        .stat-label {
            font-size: 1.3rem;
            margin-top: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .quality-focus {
            background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
            color: #fff;
            padding: 80px 0;
        }

        .quality-focus h2 {
            color: #32CD32;
            text-align: center;
            margin-bottom: 40px;
        }

        .quality-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .quality-card {
            background: rgba(50,205,50,0.1);
            padding: 30px;
            border-radius: 15px;
            border: 2px solid #32CD32;
            transition: all 0.3s ease;
        }

        .quality-card:hover {
            background: #32CD32;
            color: #000;
            transform: translateY(-10px);
        }

        .quality-card h3 {
            color: #32CD32;
            margin-bottom: 15px;
            font-size: 1.6rem;
            font-weight: 800;
        }

        .quality-card:hover h3 {
            color: #000;
        }

        .cta {
            background: linear-gradient(135deg, #32CD32 0%, #00FF00 100%);
            color: #000;
            padding: 100px 0;
            text-align: center;
        }

        .cta h2 {
            color: #000;
            font-size: 3.5rem;
            margin-bottom: 30px;
            font-weight: 900;
            text-shadow: 2px 2px 0px #fff;
        }

        .cta-text {
            font-size: 1.4rem;
            margin-bottom: 40px;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
            font-weight: 700;
        }

        .btn {
            display: inline-block;
            background: #000;
            color: #32CD32;
            padding: 25px 50px;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 900;
            font-size: 1.3rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .btn:hover {
            transform: translateY(-5px) scale(1.05);
            box-shadow: 0 20px 40px rgba(0,0,0,0.7);
            background: #fff;
            color: #000;
        }

        .highlight {
            background: linear-gradient(135deg, #32CD32 0%, #00FF00 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
        }

        .rap-scene {
            background: #000;
            color: #fff;
            padding: 80px 0;
        }

        .rap-scene h2 {
            color: #32CD32;
            text-align: center;
            margin-bottom: 40px;
        }

        .artist-showcase {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin-top: 40px;
        }

        .artist-card {
            background: linear-gradient(135deg, #32CD32 0%, #00FF00 100%);
            color: #000;
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            font-weight: 700;
            transition: all 0.3s ease;
        }

        .artist-card:hover {
            transform: scale(1.05) rotate(2deg);
        }

        .artist-card h4 {
            font-size: 2rem;
            margin-bottom: 15px;
            font-weight: 900;
        }

        @media (max-width: 768px) {
            .hero h1 {
                font-size: 3rem;
            }
            
            .hero-subtitle {
                font-size: 1.4rem;
            }
            
            .section h2 {
                font-size: 2.2rem;
            }
            
            .brand-visual h3 {
                font-size: 2.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="hero">
