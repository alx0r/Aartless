    <script>
        // Simple, minimal JavaScript for basic interactions
        document.addEventListener('DOMContentLoaded', function() {
            // Update status based on current date
            const today = new Date();
            const earlyBirdEnd = new Date('2025-11-30');
            const eventStart = new Date('2026-01-16');
            
            const statusElement = document.querySelector('.status');
            
            if (today < earlyBirdEnd) {
                statusElement.innerHTML = '<strong>Current Phase:</strong> Early Registration (15% discount until Nov 30)';
                statusElement.className = 'status status-current';
            } else if (today < eventStart) {
                statusElement.innerHTML = '<strong>Current Phase:</strong> Regular Registration';
                statusElement.className = 'status';
            } else if (today >= eventStart && today <= new Date('2026-01-21')) {
                statusElement.innerHTML = '<strong>Current Phase:</strong> Live Event in Progress';
                statusElement.className = 'status status-current';
            } else {
                statusElement.innerHTML = '<strong>Current Phase:</strong> Event Completed';
                statusElement.className = 'status';
            }
            
            // Simple booking button action
            const bookButton = document.querySelector('.cta-button');
            bookButton.addEventListener('click', function(e) {
                e.preventDefault();
